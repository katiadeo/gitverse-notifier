{{- if not .ThreadReply -}}
<p>{{tgRichPR .PullRequest}}</p>
{{- with tgRichPlain .PullRequest.Title}}
<p>{{.}}</p>
{{- end}}
{{end -}}
<details>
<summary>Комментарии · {{len .Comments}}</summary>
{{- range .Comments}}
<p>↳ {{tgRichName .Author}}</p>
{{- end}}
</details>
{{- with tgRichNotifyPRAuthor .Comments .PullRequest.Author}}
<p>{{.}}</p>
{{- end -}}
