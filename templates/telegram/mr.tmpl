<p>{{tgPRStateMarker .PullRequest}} {{tgRichPR .PullRequest}} · {{if eq .PullRequest.EffectiveState "merged"}}merged{{with tgRichName .MergedBy}} by {{.}}{{end}}{{else if eq .PullRequest.EffectiveState "closed"}}closed{{with tgRichName .PullRequest.Author}} by {{.}}{{end}}{{else}}opened{{with tgRichName .PullRequest.Author}} by {{.}}{{end}}{{end}}</p>
{{- with tgRichPRTitle .PullRequest -}}
<p>{{.}}</p>
{{- end -}}
{{- if .PullRequest.Reviewers -}}
<p>review requested · {{range $i, $r := .PullRequest.Reviewers}}{{if $i}}, {{end}}{{tgRichMention $r}}{{end}}</p>
{{- end -}}
{{- if .Comments -}}
<details open><summary>{{tgRichCommentSummary .Comments .PullRequest.Author}}</summary>
{{- range $ti, $thread := commentThreads .Comments -}}
{{- if $ti -}}
<p>&nbsp;</p>
{{- end -}}
{{- if $thread.Replies -}}
<details><summary><b>{{tgRichCopyableName $thread.Root.Author}}</b>{{with $thread.Root.URL}} · {{tgRichLink "comment" .}}{{end}}{{if $thread.Root.Edited}} · edited{{end}}{{if $thread.Replies}} · {{len $thread.Replies}} replies{{end}}</summary>
{{with tgRichQuotedComment "" $thread.Root.Body}}{{.}}{{end}}
{{- range $thread.Replies -}}
{{- $replyHdr := printf "&nbsp;&nbsp;↳ <b>%s</b>" (tgRichCopyableName .Author) -}}
{{- with .URL -}}{{- $replyHdr = printf "%s · %s" $replyHdr (tgRichLink "comment" .) -}}{{- end -}}
{{- if .Edited -}}{{- $replyHdr = printf "%s · edited" $replyHdr -}}{{- end -}}
{{with tgRichQuotedComment $replyHdr .Body}}{{.}}{{end}}
{{- end -}}
</details>
{{- else -}}
{{- $hdr := printf "<b>%s</b>" (tgRichCopyableName $thread.Root.Author) -}}
{{- with $thread.Root.URL -}}{{- $hdr = printf "%s · %s" $hdr (tgRichLink "comment" .) -}}{{- end -}}
{{- if $thread.Root.Edited -}}{{- $hdr = printf "%s · edited" $hdr -}}{{- end -}}
{{with tgRichQuotedComment $hdr $thread.Root.Body}}{{.}}{{end}}
{{- end -}}
{{- end -}}
</details>
{{- end -}}
{{- if or .Approvals .Rejections -}}
<p>{{- if .Approvals -}}Approved · {{len .Approvals}} · {{range $i, $a := .Approvals}}{{if $i}}, {{end}}{{tgRichMention $a.Author}}{{end}}{{- end}}{{- if and .Approvals .Rejections}} / {{end}}{{- if .Rejections -}}Changes requested · {{len .Rejections}} · {{range $i, $r := .Rejections}}{{if $i}}, {{end}}{{tgRichMention $r.Author}}{{end}}{{- end}}</p>
{{- end -}}
